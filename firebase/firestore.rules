rules_version = '2';

// Autorização: a fonte da verdade é usuarios/{uid} (perfis + ativo), não os
// custom claims — as regras não enxergam tokens revogados.
// A tabela de permissões espelha shared/src/permissoes.ts; os testes em
// firebase/test garantem que as duas não divergem.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function usuarioAtual() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function existeUsuarioAtual() {
      return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function ativo() {
      return logado() && existeUsuarioAtual() && usuarioAtual().ativo == true;
    }

    function temAlgum(perfis) {
      return ativo() && usuarioAtual().perfis.hasAny(perfis);
    }

    // Permissões (shared/src/permissoes.ts)
    function podeVerUsuarios() {
      return temAlgum(['admin', 'diretoria']);
    }

    function podeVerAuditoria() {
      return temAlgum(['admin', 'diretoria']);
    }

    function nomeValido(nome) {
      return nome is string && nome.size() >= 2 && nome.size() <= 100;
    }

    function telefoneValido(telefone) {
      return telefone == null || (telefone is string && telefone.matches('^[0-9]{10,11}$'));
    }

    match /usuarios/{uid} {
      allow read: if (logado() && request.auth.uid == uid) || podeVerUsuarios();

      // O próprio usuário só edita nome e telefone; o resto é gravado pelas Functions.
      allow update: if logado()
        && request.auth.uid == uid
        && resource.data.ativo == true
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['nome', 'telefone', 'atualizadoEm'])
        && nomeValido(request.resource.data.nome)
        && telefoneValido(request.resource.data.telefone)
        && (!('atualizadoEm' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.atualizadoEm == request.time);

      allow create, delete: if false;
    }

    match /auditoria/{id} {
      allow read: if podeVerAuditoria();
      allow write: if false;
    }

    // ---- Subprojeto 2: portal e voluntários ----

    function podeEditarPublicacoes() {
      return temAlgum(['admin', 'editor']);
    }

    function podeEditarDoacoes() {
      return temAlgum(['admin', 'editor']);
    }

    function podeVerVoluntarios() {
      return temAlgum(['admin', 'diretoria', 'coord_voluntarios']);
    }

    function podeEditarTransparencia() {
      return temAlgum(['admin', 'diretoria', 'tesouraria']);
    }

    function podeConfigurarPortal() {
      return temAlgum(['admin']);
    }

    function publicacaoValida(d) {
      return d.titulo is string && d.titulo.size() >= 3 && d.titulo.size() <= 140
        && d.resumo is string && d.resumo.size() <= 280
        && d.slug is string && d.slug.size() >= 1 && d.slug.size() <= 80
        && d.categoria in ['noticia', 'campanha', 'evento']
        && d.status in ['rascunho', 'publicada']
        && d.galeria is list && d.galeria.size() <= 20
        && d.slugFixado is bool;
    }

    match /publicacoes/{id} {
      allow read: if resource.data.status == 'publicada' || podeEditarPublicacoes();
      allow create: if podeEditarPublicacoes() && publicacaoValida(request.resource.data);
      // O slug é fixado na primeira publicação para não quebrar links compartilhados.
      allow update: if podeEditarPublicacoes()
        && publicacaoValida(request.resource.data)
        && (resource.data.slugFixado != true || request.resource.data.slug == resource.data.slug);
      allow delete: if podeEditarPublicacoes() && resource.data.publicadoEm == null;
    }

    // Escritos só pelas Functions (inscreverVoluntario, atualizarVoluntario).
    match /voluntarios/{id} {
      allow read: if podeVerVoluntarios();
      allow write: if false;
    }

    match /inscricoesRecentes/{id} {
      allow read, write: if false;
    }

    function documentoValido(d) {
      return d.titulo is string && d.titulo.size() >= 3 && d.titulo.size() <= 140
        && d.ano is int
        && d.categoria in ['prestacao_contas', 'relatorio_atividades', 'documentos_legais', 'outros']
        && d.arquivado is bool;
    }

    match /documentos/{id} {
      allow read: if resource.data.arquivado == false || podeEditarTransparencia();
      allow create, update: if podeEditarTransparencia() && documentoValido(request.resource.data);
      allow delete: if false;
    }

    match /config/portal {
      allow read: if true;
      allow write: if podeConfigurarPortal();
    }

    match /config/doacoes {
      allow read: if true;
      allow write: if podeEditarDoacoes();
    }

    // Escrito só pela Function definirPix (com auditoria).
    match /config/pix {
      allow read: if true;
      allow write: if false;
    }
  }
}
