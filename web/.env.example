# Copie para .env.local e preencha com a configuração do app web do Firebase
# (Console do Firebase → Configurações do projeto → Seus apps).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Chave do site reCAPTCHA Enterprise usada pelo App Check.
NEXT_PUBLIC_RECAPTCHA_KEY=
# true para usar os emuladores locais (npm run emuladores na raiz).
NEXT_PUBLIC_USAR_EMULADORES=true
# Banco do Firestore (vazio ou "(default)" nos emuladores).
NEXT_PUBLIC_FIRESTORE_DATABASE=
